NODE_ENV=development
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=jema_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=REMPLACER_PAR_LE_MOT_DE_PASSE_POSTGRESQL
DATABASE_SSL=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Générer AUTH_TOKEN_PEPPER avec : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN_PEPPER=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_32_OCTETS_MINIMUM

# Codes visibles uniquement en développement local (désactivés en production par validation).
AUTH_EXPOSE_DEV_CODES=true
AUTH_SESSION_TTL_HOURS=720
AUTH_CODE_TTL_MINUTES=15
AUTH_RESET_TTL_MINUTES=30
